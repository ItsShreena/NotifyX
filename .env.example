# ==============================================================================
# NotifyX — Production Environment Configuration Template (.env.example)
# Copy this file to .env and configure real values. Never commit secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Networking
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000

# ------------------------------------------------------------------------------
# 2. Production URL Configuration
# ------------------------------------------------------------------------------
# FRONTEND_URL: Used by CORS middleware to whitelist requests from your UI
FRONTEND_URL="https://notifyx.example.com"

# API_URL: Base URL of the NotifyX API for server-side clients
API_URL="https://api.notifyx.example.com"

# VITE_API_URL: Public API URL for Vite / React client (leave blank if served from same origin)
VITE_API_URL=""

# ------------------------------------------------------------------------------
# 3. Persistent Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Required for production deployments. Used by Prisma Client & migrations.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ------------------------------------------------------------------------------
# 4. Redis & BullMQ Queue Infrastructure
# ------------------------------------------------------------------------------
# Dedicated Redis instance for distributed message queuing and sliding-window rate limiting.
# Format: redis://[:PASSWORD@]HOST:PORT[/DB] or rediss:// for TLS
REDIS_URL="redis://default:your_redis_password@redis.example.com:6379"
REDIS_HOST="redis.example.com"
REDIS_PORT=6379
REDIS_PASSWORD="your_redis_password"

# ------------------------------------------------------------------------------
# 5. Developer Authentication & Session Security (JWT)
# ------------------------------------------------------------------------------
# Long, cryptographically random secret for signing developer JWTs (min 32 characters)
JWT_SECRET="generate-a-strong-random-secret-key-for-production"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 6. Multi-Channel Notification Delivery Providers
# ------------------------------------------------------------------------------
# Email provider adapter: "mock" (default safe development mode) or "resend" (live provider)

EMAIL_PROVIDER="resend"
RESEND_FROM_EMAIL="onboarding@resend.dev"
# Backwards-compatible alias for environments that still use the older RESEND_EMAIL_FROM name:
RESEND_EMAIL_FROM="onboarding@resend.dev"
RESEND_FROM_NAME="NotifyX"
EMAIL_DIAGNOSTIC_ENABLED="true"
ADMIN_EMAILS="admin@example.com"

# Push provider adapter: "mock" (built-in zero-cost development) or future "fcm" / "apns"
PUSH_PROVIDER="mock"

# ------------------------------------------------------------------------------
# 7. AI Notification Intelligence (Optional)
# ------------------------------------------------------------------------------
# Leave empty to use deterministic fallback classification without calling LLMs.
AI_API_KEY=""
AI_MODEL="gemini-3.8-flash"
AI_BASE_URL=""
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 8. Distributed Rate Limiting & Security (Section 13)
# ------------------------------------------------------------------------------
# Window duration in milliseconds for application-level API endpoints (default: 60,000ms = 1 min)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window per application (default: 100 requests/min)
RATE_LIMIT_MAX_REQUESTS=100

# Authentication endpoint protection: maximum failed login attempts per 15-minute window per IP
AUTH_RATE_LIMIT_MAX=5
